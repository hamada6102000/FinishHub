@model FinishHub.Admin.Models.UserTypeFormViewModel

@{
    ViewData["Title"] = "Edit User Type";
    var currentPage = ViewData["Page"] as int? ?? 1;
    var pageSize    = ViewData["PageSize"] as int? ?? FinishHub.Admin.Models.PagedResult<object>.DefaultPageSize;
}

<h1 class="h3 mb-3">Edit User Type</h1>

<div class="card shadow-sm" style="max-width: 480px;">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" asp-route-page="@currentPage" asp-route-pageSize="@pageSize" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="IsSystem" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            @if (Model.IsSystem)
            {
                <div class="alert alert-info py-2">
                    This is a built-in type. It can be renamed, but it cannot be deactivated or deleted
                    because the application relies on it.
                </div>
            }

            <div class="mb-3">
                <label asp-for="NameEn" class="form-label"></label>
                <input asp-for="NameEn" class="form-control" autofocus />
                <span asp-validation-for="NameEn" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NameAr" class="form-label"></label>
                <input asp-for="NameAr" class="form-control" dir="rtl" />
                <span asp-validation-for="NameAr" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsActive" class="form-check-input" disabled="@Model.IsSystem" />
                <label asp-for="IsActive" class="form-check-label"></label>
                <div class="form-text">
                    Deactivating keeps the users already assigned to this type exactly as they are —
                    it only removes the type from signup and from future assignment.
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" asp-route-page="@currentPage" asp-route-pageSize="@pageSize" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
