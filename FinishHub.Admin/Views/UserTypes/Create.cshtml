@model FinishHub.Admin.Models.UserTypeFormViewModel

@{
    ViewData["Title"] = "Add User Type";
    var pageSize = ViewData["PageSize"] as int? ?? FinishHub.Admin.Models.PagedResult<object>.DefaultPageSize;
}

<h1 class="h3 mb-3">Add User Type</h1>

<div class="card shadow-sm" style="max-width: 480px;">
    <div class="card-body">
        <form asp-action="Create" asp-route-pageSize="@pageSize" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="NameEn" class="form-label"></label>
                <input asp-for="NameEn" class="form-control" autofocus />
                <span asp-validation-for="NameEn" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NameAr" class="form-label"></label>
                <input asp-for="NameAr" class="form-control" dir="rtl" />
                <span asp-validation-for="NameAr" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
                <div class="form-text">Only active types can be selected at signup or assigned to a user.</div>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" asp-route-pageSize="@pageSize" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
