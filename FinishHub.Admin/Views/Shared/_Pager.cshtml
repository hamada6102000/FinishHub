@model FinishHub.Admin.Models.PagerViewModel

@if (Model.TotalCount > 0)
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small">
                Showing @Model.FirstItemNumber–@Model.LastItemNumber of @Model.TotalCount
            </span>
            <form method="get" class="d-flex align-items-center gap-1">
                <input type="hidden" name="page" value="1" />
                <label class="text-muted small mb-0" for="pageSize">Per page</label>
                <select id="pageSize" name="pageSize" class="form-select form-select-sm w-auto"
                        onchange="this.form.submit();">
                    @foreach (var size in FinishHub.Admin.Models.PagerViewModel.PageSizeOptions)
                    {
                        <option value="@size" selected="@(size == Model.PageSize)">@size</option>
                    }
                </select>
            </form>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Pagination">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                        <a class="page-link" asp-route-page="1" asp-route-pageSize="@Model.PageSize"
                           aria-label="First page">&laquo;</a>
                    </li>
                    <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                        <a class="page-link" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize"
                           aria-label="Previous page">&lsaquo;</a>
                    </li>

                    @for (var p = Model.FirstPageLink; p <= Model.LastPageLink; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link" asp-route-page="@p" asp-route-pageSize="@Model.PageSize">@p</a>
                        </li>
                    }

                    <li class="page-item @(Model.HasNext ? "" : "disabled")">
                        <a class="page-link" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize"
                           aria-label="Next page">&rsaquo;</a>
                    </li>
                    <li class="page-item @(Model.HasNext ? "" : "disabled")">
                        <a class="page-link" asp-route-page="@Model.TotalPages" asp-route-pageSize="@Model.PageSize"
                           aria-label="Last page">&raquo;</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
