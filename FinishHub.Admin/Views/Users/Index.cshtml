@model FinishHub.Admin.Models.PagedResult<FinishHub.Admin.Models.UserViewModel>

@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Users</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Type</th>
                    <th>Created</th>
                    <th>Trusted</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            @(Model.TotalCount == 0 ? "No users have been added yet." : "This page is empty.")
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var user in Model.Items)
                    {
                        <tr>
                            <td>@user.NameEn</td>
                            <td>@user.Email</td>
                            <td>@user.PhoneNumber</td>
                            <td>@user.UserType</td>
                            <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (user.IsTrusted)
                                {
                                    <span class="badge bg-success">Trusted</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Not trusted</span>
                                }
                            </td>
                            <td class="text-end">
                                <form asp-action="SetTrusted" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <input type="hidden" name="isTrusted" value="@((!user.IsTrusted).ToString().ToLowerInvariant())" />
                                    <input type="hidden" name="page" value="@Model.Page" />
                                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                    <button type="submit" class="btn btn-sm @(user.IsTrusted ? "btn-outline-secondary" : "btn-outline-success")">
                                        @(user.IsTrusted ? "Unmark Trusted" : "Mark Trusted")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@{await Html.RenderPartialAsync("_Pager", FinishHub.Admin.Models.PagerViewModel.From(Model));}
