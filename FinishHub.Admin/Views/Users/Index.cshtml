@model FinishHub.Admin.Models.PagedResult<FinishHub.Admin.Models.UserViewModel>

@{
    ViewData["Title"] = "Users";

    // Active types only — a deactivated type cannot be assigned, so it is never offered here.
    var userTypes = ViewData["UserTypes"] as List<FinishHub.Admin.Models.UserTypeViewModel>
        ?? new List<FinishHub.Admin.Models.UserTypeViewModel>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Users</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Type</th>
                    <th>Created</th>
                    <th>Status</th>
                    <th>Trusted</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            @(Model.TotalCount == 0 ? "No users have been added yet." : "This page is empty.")
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var user in Model.Items)
                    {
                        <tr class="@(user.IsActive ? null : "table-warning")">
                            <td>@user.NameEn</td>
                            <td>@user.Email</td>
                            <td>@user.PhoneNumber</td>
                            <td style="min-width: 15rem;">
                                @{
                                    // A user whose type was deactivated keeps it, but it is not in
                                    // the list — leave the dropdown on a placeholder so nobody
                                    // reassigns them by accident just by pressing Save.
                                    var currentIsSelectable = userTypes.Any(t => t.Id == user.UserTypeId);
                                }
                                <div class="mb-1">
                                    <span class="fw-semibold">@user.DisplayUserType</span>
                                    @if (!currentIsSelectable)
                                    {
                                        <span class="badge bg-warning text-dark ms-1" title="This type has been deactivated.">Inactive type</span>
                                    }
                                </div>
                                <form asp-action="SetType" method="post" class="d-flex gap-1">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <input type="hidden" name="page" value="@Model.Page" />
                                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                    <select name="userTypeId" class="form-select form-select-sm">
                                        @if (!currentIsSelectable)
                                        {
                                            <option value="0" selected>Change type…</option>
                                        }
                                        @foreach (var type in userTypes)
                                        {
                                            <option value="@type.Id" selected="@(type.Id == user.UserTypeId)">@type.NameEn</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                                </form>
                            </td>
                            <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td>
                                @if (user.IsTrusted)
                                {
                                    <span class="badge bg-success">Trusted</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Not trusted</span>
                                }
                            </td>
                            <td class="text-end">
                                <form asp-action="SetActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <input type="hidden" name="isActive" value="@((!user.IsActive).ToString().ToLowerInvariant())" />
                                    <input type="hidden" name="page" value="@Model.Page" />
                                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                    <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        @(user.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                                <form asp-action="SetTrusted" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <input type="hidden" name="isTrusted" value="@((!user.IsTrusted).ToString().ToLowerInvariant())" />
                                    <input type="hidden" name="page" value="@Model.Page" />
                                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                    <button type="submit" class="btn btn-sm @(user.IsTrusted ? "btn-outline-secondary" : "btn-outline-success")">
                                        @(user.IsTrusted ? "Unmark Trusted" : "Mark Trusted")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@{await Html.RenderPartialAsync("_Pager", FinishHub.Admin.Models.PagerViewModel.From(Model));}
