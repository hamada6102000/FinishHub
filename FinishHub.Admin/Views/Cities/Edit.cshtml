@model FinishHub.Admin.Models.CityFormViewModel

@{
    ViewData["Title"] = "Edit City";
}

<h1 class="h3 mb-3">Edit City</h1>

<div class="card shadow-sm" style="max-width: 480px;">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="NameEn" class="form-label"></label>
                <input asp-for="NameEn" class="form-control" autofocus />
                <span asp-validation-for="NameEn" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NameAr" class="form-label"></label>
                <input asp-for="NameAr" class="form-control" dir="rtl" />
                <span asp-validation-for="NameAr" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsPinned" class="form-check-input" />
                <label asp-for="IsPinned" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
