@model FinishHub.Admin.Models.PagedResult<FinishHub.Admin.Models.CityViewModel>

@{
    ViewData["Title"] = "Cities";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Cities</h1>
    <a asp-action="Create" asp-route-pageSize="@Model.PageSize" class="btn btn-primary">+ Add City</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Name (English)</th>
                    <th>Name (Arabic)</th>
                    <th>Pinned</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            @(Model.TotalCount == 0 ? "No cities have been added yet." : "This page is empty.")
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var city in Model.Items)
                    {
                        <tr>
                            <td>@city.NameEn</td>
                            <td>@city.NameAr</td>
                            <td>
                                @if (city.IsPinned)
                                {
                                    <span class="badge bg-success">Pinned</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Not pinned</span>
                                }
                            </td>
                            <td>@city.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">
                                <form asp-action="SetPinned" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@city.Id" />
                                    <input type="hidden" name="isPinned" value="@((!city.IsPinned).ToString().ToLowerInvariant())" />
                                    <input type="hidden" name="page" value="@Model.Page" />
                                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                    <button type="submit" class="btn btn-sm @(city.IsPinned ? "btn-outline-secondary" : "btn-outline-success")">
                                        @(city.IsPinned ? "Unpin" : "Pin")
                                    </button>
                                </form>
                                <a asp-action="Edit" asp-route-id="@city.Id" asp-route-page="@Model.Page"
                                   asp-route-pageSize="@Model.PageSize" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <form asp-action="Delete" asp-route-id="@city.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete city &quot;@city.NameEn&quot;? This cannot be undone.');">
                                    <input type="hidden" name="page" value="@Model.Page" />
                                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@{await Html.RenderPartialAsync("_Pager", FinishHub.Admin.Models.PagerViewModel.From(Model));}
